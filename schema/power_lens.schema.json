{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exmxc.ai/schemas/power-lens/v1",
  "title": "exmxc Legacy Power Lens v1 Response",
  "description": "Historical compatibility response based on the legacy v1 weighted exposure scaffold and adjacent bundled datasets. It is not an AI Power v2 profile.",
  "type": "object",
  "required": ["product", "version", "model_status", "current_authority", "query", "found", "generated_at"],
  "properties": {
    "product": { "type": "string", "const": "exmxc Power Lens" },
    "version": { "type": "string" },
    "model_status": { "const": "legacy_exposure_scaffold" },
    "current_authority": { "const": false },
    "query": { "type": "string" },
    "found": { "type": "boolean" },
    "generated_at": { "type": "string" },
    "match": { "type": ["object", "null"] },
    "power": { "type": ["object", "null"] },
    "four_forces": { "type": "array" },
    "entity_clarity": { "type": ["object", "null"] },
    "scarcity": { "type": ["object", "null"] },
    "reality_gap": { "type": ["object", "null"] },
    "interpretation": { "type": ["object", "null"] },
    "coverage": { "type": "object" },
    "provenance": { "type": "object" },
    "disclaimer": { "type": "string" },
    "suggestions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
