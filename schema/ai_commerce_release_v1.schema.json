{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.exmxc.ai/schemas/ai-commerce-release-v1",
  "title": "AI Commerce Signal Release v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_id", "series_id", "as_of", "methodology_id", "status", "coverage", "experience_readings", "episode_count_by_stage", "episode_count_by_category", "benchmarks", "notes"],
  "properties": {
    "release_id":{"type":"string","minLength":1},
    "series_id":{"const":"ai-commerce-signal-v1"},
    "as_of":{"type":"string","format":"date"},
    "methodology_id":{"const":"ai-commerce-v1.0.0"},
    "status":{"enum":["foundation","pilot"]},
    "coverage":{"type":"object","additionalProperties":false,"required":["verified_episode_count","selection_run_count","transaction_event_count"],"properties":{"verified_episode_count":{"type":"integer","minimum":0},"selection_run_count":{"type":"integer","minimum":0},"transaction_event_count":{"type":"integer","minimum":0}}},
    "experience_readings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["target","status","episode_count","sentiment_share"],"properties":{"target":{"type":"string"},"status":{"enum":["measured","insufficient_evidence"]},"episode_count":{"type":"integer","minimum":0},"sentiment_share":{"type":["object","null"],"additionalProperties":{"type":"number","minimum":0,"maximum":1}}}}},
    "episode_count_by_stage":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
    "episode_count_by_category":{"type":"object","additionalProperties":{"type":"integer","minimum":0}},
    "benchmarks":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","lane","label","value","unit","period","geography","denominator","source_url","source_organization","interpretation"],"properties":{"id":{"type":"string"},"lane":{"enum":["survey","referral","search_interest"]},"label":{"type":"string"},"value":{"type":"number"},"unit":{"type":"string"},"period":{"type":"string"},"geography":{"type":"string"},"denominator":{"type":"string"},"source_url":{"type":"string","format":"uri"},"source_organization":{"type":"string"},"interpretation":{"type":"string"}}}},
    "search_interest":{
      "type":"object","additionalProperties":false,
      "required":["source","source_url","exported_on","raw_file","raw_sha256","geography","search_type","category","window","interval","scale","last_complete_week","excluded_incomplete_weeks","series"],
      "properties":{
        "source":{"const":"Google Trends"},"source_url":{"type":"string","format":"uri"},
        "exported_on":{"type":"string","format":"date"},"raw_file":{"type":"string","minLength":1},
        "raw_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "geography":{"const":"US"},"search_type":{"const":"Web Search"},"category":{"const":"All categories"},
        "window":{"type":"string"},"interval":{"const":"week"},"scale":{"type":"string","minLength":40},
        "last_complete_week":{"type":"string","format":"date"},
        "excluded_incomplete_weeks":{"type":"array","items":{"type":"string","format":"date"}},
        "series":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["term","points"],"properties":{"term":{"enum":["ChatGPT shopping","AI shopping assistant"]},"points":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["week","index"],"properties":{"week":{"type":"string","format":"date"},"index":{"type":"integer","minimum":0,"maximum":100}}}}}}}
      }
    },
    "selection_panel":{
      "type":"object","additionalProperties":false,
      "required":["panel_id","status","geography","representative","protocol_version","protocol_sha","intent_panel_version","intent_panel_sha","observed_on","adjudicated_on","source_archive_name","source_archive_sha256","source_access","intents","attempts","supplemental_observations","notes","summary"],
      "properties":{
        "panel_id":{"type":"string"},"status":{"const":"method_validation"},"geography":{"const":"US"},"representative":{"const":false},
        "protocol_version":{"type":"string"},"protocol_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "intent_panel_version":{"type":"string"},"intent_panel_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "observed_on":{"type":"string","format":"date"},"adjudicated_on":{"type":"string","format":"date"},
        "source_archive_name":{"type":"string"},"source_archive_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "source_access":{"const":"private_operator_supplied_captures"},
        "intents":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["intent_id","category","label"],"properties":{"intent_id":{"type":"string"},"category":{"type":"string"},"label":{"type":"string"}}}},
        "attempts":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["attempt_id","intent_id","surface","displayed_mode","observed_on","attempt_number","outcome","turns_completed","selection","evidence_limit","raw_capture_sha256"],"properties":{"attempt_id":{"type":"string"},"intent_id":{"type":"string"},"surface":{"enum":["ChatGPT","Gemini"]},"displayed_mode":{"type":"string"},"observed_on":{"type":"string","format":"date"},"attempt_number":{"type":"integer","minimum":1},"outcome":{"enum":["single","joint","abstained","unranked","contradictory","technical_failure"]},"turns_completed":{"enum":[0,2]},"selection":{"type":["object","null"],"additionalProperties":false,"required":["brand","product","granularity"],"properties":{"brand":{"type":"string"},"product":{"type":"string"},"granularity":{"enum":["variant","model","conditional_configuration","model_family"]}}},"evidence_limit":{"type":"string"},"raw_capture_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
        "supplemental_observations":{"type":"array","items":{"type":"object","required":["intent_id","surface","provenance","outcome","product","included_in_counts","limitation"],"properties":{"intent_id":{"type":"string"},"surface":{"type":"string"},"provenance":{"type":"string"},"outcome":{"type":"string"},"product":{"type":"string"},"included_in_counts":{"const":false},"limitation":{"type":"string"}}}},
        "notes":{"type":"string"},
        "summary":{"type":"object","additionalProperties":false,"required":["original_app_intent_cells","physical_attempts","retry_attempts","completed_two_turn_attempts","clean_single_attempts","contradictory_attempts","technical_failure_attempts","clean_selection_cells","contradictory_cells","unresolved_failure_cells","selection_share","cell_outcomes"],"properties":{"original_app_intent_cells":{"type":"integer","minimum":1},"physical_attempts":{"type":"integer","minimum":1},"retry_attempts":{"type":"integer","minimum":0},"completed_two_turn_attempts":{"type":"integer","minimum":0},"clean_single_attempts":{"type":"integer","minimum":0},"contradictory_attempts":{"type":"integer","minimum":0},"technical_failure_attempts":{"type":"integer","minimum":0},"clean_selection_cells":{"type":"integer","minimum":0},"contradictory_cells":{"type":"integer","minimum":0},"unresolved_failure_cells":{"type":"integer","minimum":0},"selection_share":{"type":"null"},"cell_outcomes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["intent_id","surface","attempt_ids","outcome","primary_selection"],"properties":{"intent_id":{"type":"string"},"surface":{"enum":["ChatGPT","Gemini"]},"attempt_ids":{"type":"array","items":{"type":"string"}},"outcome":{"enum":["single","joint","abstained","unranked","contradictory","technical_failure"]},"primary_selection":{"type":["object","null"],"additionalProperties":false,"required":["brand","product","granularity"],"properties":{"brand":{"type":"string"},"product":{"type":"string"},"granularity":{"type":"string"}}}}}}}}
      }
    },
    "api_method_check":{"type":"object","additionalProperties":false,"required":["panel_id","status","observed_on","geography","representative","surface","provider_models","intent_count","completed_two_turn_tasks","categories","requirement_review","material_answer_claim_issue","source_audit","source_product_audit","source_access","interpretation"],"properties":{"panel_id":{"type":"string"},"status":{"const":"method_validation"},"observed_on":{"type":"string","format":"date"},"geography":{"const":"US"},"representative":{"const":false},"surface":{"const":"provider_api"},"provider_models":{"type":"array","items":{"type":"string"}},"intent_count":{"type":"integer","minimum":1},"completed_two_turn_tasks":{"type":"integer","minimum":1},"categories":{"type":"array","items":{"type":"string"}},"requirement_review":{"type":"object","additionalProperties":false,"required":["reviewed","verified","unknown","contradicted"],"properties":{"reviewed":{"type":"integer"},"verified":{"type":"integer"},"unknown":{"type":"integer"},"contradicted":{"type":"integer"}}},"material_answer_claim_issue":{"type":"string"},"source_audit":{"type":"string"},"source_product_audit":{"type":"string"},"source_access":{"type":"string"},"interpretation":{"type":"string"}}},
    "notes":{"type":"string"}
  }
}
