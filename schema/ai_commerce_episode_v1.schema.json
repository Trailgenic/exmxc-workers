{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.exmxc.ai/schemas/ai-commerce-episode-v1",
  "title": "AI Commerce Episode v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode_id", "observed_at", "source_url", "source_origin", "access_basis", "evidence_type", "evidence_excerpt", "ai_tool", "shopping_task", "category", "stage", "delegation", "outcome", "experience", "classification_confidence"],
  "properties": {
    "episode_id": {"type":"string","minLength":1},
    "observed_at": {"type":"string","format":"date-time"},
    "source_url": {"type":"string","format":"uri","pattern":"^https://"},
    "source_origin": {"type":"string","minLength":1},
    "access_basis": {"enum":["permitted_public","licensed","consented"]},
    "evidence_type": {"enum":["first_person_report","instrumented_event"]},
    "evidence_excerpt": {"type":"string","minLength":10},
    "ai_tool": {"type":"string","minLength":1},
    "shopping_task": {"type":"string","minLength":1},
    "category": {"type":"string","minLength":1},
    "product": {"type":["string","null"]},
    "merchant": {"type":["string","null"]},
    "stage": {"enum":["discovery","comparison","recommendation","selection","cart","checkout","post_purchase"]},
    "delegation": {"enum":["human_directed","ai_assisted","agent_prepared","agent_executed"]},
    "outcome": {"enum":["unknown","considered","referred","carted","purchased","abandoned","returned"]},
    "purchase_evidence": {"type":["string","null"]},
    "delegated_checkout_evidence": {"type":["string","null"]},
    "experience": {
      "type":"object","additionalProperties":false,"required":["target","sentiment"],
      "properties": {
        "target":{"enum":["usefulness","accuracy","trust","price_confidence","control","privacy","disclosure","friction",null]},
        "sentiment":{"enum":["positive","negative","mixed","neutral","unknown"]}
      }
    },
    "classification_confidence": {"type":"number","minimum":0,"maximum":1}
  }
}
