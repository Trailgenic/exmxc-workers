{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.exmxc.ai/schemas/entity-clarity-evidence-v2",
  "title": "Automated Entity Clarity Evidence v2.1 Pilot Response",
  "type": "object",
  "required": ["success", "methodology", "run_id", "url", "collection", "robots", "declared_access", "machine_evidence", "assessment", "model_representation", "legacy_diagnostic", "timestamp"],
  "properties": {
    "success": { "const": true },
    "methodology": { "const": "Entity Clarity evidence v2.1-pilot" },
    "run_id": { "type": "string", "format": "uuid" },
    "url": { "type": "string", "format": "uri" },
    "hostname": { "type": "string" },
    "collection": { "$ref": "#/$defs/fetchObservation" },
    "robots": {
      "allOf": [
        { "$ref": "#/$defs/fetchObservation" },
        {
          "type": "object",
          "required": ["document_status"],
          "properties": { "document_status": { "enum": ["available", "unavailable", "unreachable", "fetch_error"] } }
        }
      ]
    },
    "declared_access": {
      "type": "object",
      "required": ["source", "posture", "provider_purpose", "indexing_directives", "interpretation_boundary"],
      "properties": {
        "source": { "const": "robots.txt" },
        "posture": { "enum": ["permissive", "selective", "restrictive", "unknown"] },
        "provider_purpose": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "purpose", "token", "decision", "reason"],
            "properties": {
              "provider": { "type": "string" },
              "purpose": { "enum": ["training", "search", "user_request", "ai_use"] },
              "token": { "type": "string" },
              "decision": { "enum": ["allowed", "disallowed", "unknown"] },
              "reason": { "type": "string" },
              "rule": { "type": ["object", "null"] }
            },
            "additionalProperties": true
          }
        },
        "indexing_directives": {
          "type": "object",
          "required": ["x_robots_tag", "meta_robots"],
          "properties": {
            "x_robots_tag": { "type": "array", "items": { "type": "string" } },
            "meta_robots": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "interpretation_boundary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "machine_evidence": { "type": ["object", "null"] },
    "assessment": {
      "type": "object",
      "required": ["methodology", "methodology_status", "assessment_mode", "status", "score_meaning", "score", "comparable", "coverage", "dimensions", "evidence_basis"],
      "properties": {
        "methodology": { "const": "Automated Entity Clarity v2.1 pilot" },
        "methodology_status": { "const": "experimental" },
        "assessment_mode": { "const": "automated_deterministic" },
        "status": { "enum": ["scored", "unassessable"] },
        "score_meaning": { "type": "string" },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "comparable": { "type": "boolean" },
        "coverage": {
          "type": "object",
          "required": ["measured", "total", "percent"],
          "properties": {
            "measured": { "type": "integer", "minimum": 0, "maximum": 5 },
            "total": { "const": 5 },
            "percent": { "type": "number", "minimum": 0, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "dimensions": {
          "type": "object",
          "required": ["identity_resolution", "entity_consistency", "relationship_clarity", "evidence_traceability", "machine_legibility"],
          "properties": {
            "identity_resolution": { "$ref": "#/$defs/dimensionSummary" },
            "entity_consistency": { "$ref": "#/$defs/dimensionSummary" },
            "relationship_clarity": { "$ref": "#/$defs/dimensionSummary" },
            "evidence_traceability": { "$ref": "#/$defs/dimensionSummary" },
            "machine_legibility": { "$ref": "#/$defs/dimensionSummary" }
          },
          "additionalProperties": false
        },
        "evidence_basis": {
          "type": "object",
          "required": ["collection_status", "surface", "mode"],
          "properties": {
            "collection_status": { "type": "string" },
            "surface": { "const": "homepage" },
            "mode": { "const": "static" },
            "content_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "note": { "type": "string" },
            "limitations": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "scored" } }, "required": ["status"] },
          "then": {
            "properties": {
              "score": { "type": "number" },
              "comparable": { "const": true },
              "coverage": { "properties": { "measured": { "const": 5 }, "percent": { "const": 100 } } }
            }
          },
          "else": {
            "properties": {
              "score": { "const": null },
              "comparable": { "const": false },
              "coverage": { "properties": { "measured": { "const": 0 }, "percent": { "const": 0 } } }
            }
          }
        }
      ]
    },
    "model_representation": {
      "type": "object",
      "required": ["status", "results", "note"],
      "properties": {
        "status": { "enum": ["not_tested", "tested"] },
        "results": { "type": "array" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "legacy_diagnostic": { "type": ["object", "null"] },
    "interpretation_boundary": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "dimensionSummary": {
      "type": "object",
      "required": ["label", "weight", "status", "score", "weighted_points", "max_points", "signals"],
      "properties": {
        "label": { "type": "string" },
        "weight": { "type": "number", "minimum": 0, "maximum": 100 },
        "status": { "enum": ["measured", "unassessable"] },
        "score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "weighted_points": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "max_points": { "type": "number", "minimum": 0, "maximum": 100 },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "status", "points", "max", "evidence"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "status": { "enum": ["present", "absent"] },
              "points": { "type": "number", "minimum": 0, "maximum": 100 },
              "max": { "type": "number", "minimum": 0, "maximum": 100 },
              "evidence": {}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fetchObservation": {
      "type": "object",
      "required": ["requested_url", "final_url", "fetch_status", "http_status", "surface_type", "collection_mode", "collector_version", "content_sha256", "error"],
      "properties": {
        "requested_url": { "type": "string", "format": "uri" },
        "final_url": { "type": ["string", "null"], "format": "uri" },
        "fetch_status": { "enum": ["delivered", "unsupported_content", "access_restricted", "not_found", "rate_limited", "server_error", "http_error", "rejected", "timeout", "dns_error", "tls_error", "redirect_error", "response_error", "network_error"] },
        "http_status": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
        "content_type": { "type": ["string", "null"] },
        "surface_type": { "enum": ["homepage", "robots"] },
        "collection_mode": { "const": "static" },
        "collector_version": { "type": "string" },
        "content_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "x_robots_tag": { "type": "array", "items": { "type": "string" } },
        "redirects": { "type": "array" },
        "error": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
